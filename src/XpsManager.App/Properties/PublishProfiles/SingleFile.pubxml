<?xml version="1.0" encoding="utf-8"?>
<!--
  One XpsManager.exe in /dist. It uses the installed .NET 10 Desktop Runtime, which keeps the
  file small and startup fast. For a machine without the runtime, publish with
  -p:SelfContained=true -p:EnableCompressionInSingleFile=true (much larger, slower first paint).
    dotnet publish src/XpsManager.App -p:PublishProfile=SingleFile
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>none</DebugType>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\dist\</PublishDir>
  </PropertyGroup>
</Project>
