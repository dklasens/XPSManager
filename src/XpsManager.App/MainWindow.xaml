<!-- Hallmark · single-window tabbed utility · Cobalt · no motion
     pre-emit critique: P4 H5 E4 S5 R5 V4 · compact summary, three focused tabs -->
<Window x:Class="XpsManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:XpsManager.App"
        Title="XPS Manager" Icon="Assets/XpsManager.ico"
        Width="600" Height="820" MinWidth="560" MinHeight="640"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Paper}" Foreground="{StaticResource Ink2}"
        FontFamily="{StaticResource FontBody}" FontSize="{StaticResource TextBody}" UseLayoutRounding="True">
    <Window.Resources>
        <DataTemplate x:Key="SegmentTemplate">
            <RadioButton Style="{StaticResource Segment}" Content="{Binding ShortLabel}" IsChecked="{Binding IsSelected}"
                         AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding Description}"
                         AutomationProperties.ItemStatus="{Binding AutomationStatus}" />
        </DataTemplate>
        <Style x:Key="SegmentGroup" TargetType="ItemsControl">
            <Setter Property="ItemTemplate" Value="{StaticResource SegmentTemplate}" />
            <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></Setter.Value></Setter>
            <Setter Property="Focusable" Value="False" />
            <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
            <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Cycle" />
            <Setter Property="Margin" Value="0,12,-8,0" />
        </Style>
    </Window.Resources>
    <DockPanel Background="{StaticResource Paper}">
        <Border DockPanel.Dock="Top" Background="{StaticResource Graphite}" Padding="24,16,24,20">
            <StackPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock Text="{Binding AppVersion}" Style="{StaticResource ReadoutLabel}" Margin="0,0,16,0" ToolTip="XPS Manager version" />
                        <TextBlock Text="{Binding Device.BiosVersion, StringFormat='BIOS {0}'}" Style="{StaticResource ReadoutLabel}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource XpsMark}" Width="16" Height="16" AutomationProperties.Name="XPS Manager" />
                        <TextBlock Text="{Binding Device.Model}" Margin="10,0,0,0" FontWeight="Medium" Foreground="{StaticResource GraphiteInk}" />
                    </StackPanel>
                </DockPanel>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="144" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Live.BatteryPercent}" FontFamily="{StaticResource FontDisplay}" FontSize="{StaticResource TextPower}"
                                   FontWeight="Bold" Foreground="{StaticResource GraphiteInk}" LineHeight="42" LineStackingStrategy="BlockLineHeight" />
                        <TextBlock Text="{Binding Live.PowerSource}" Style="{StaticResource ReadoutLabel}" Margin="0,4,12,0"
                                   ToolTip="{Binding Live.SourceLine}" ToolTipService.InitialShowDelay="800" />
                    </StackPanel>
                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="84" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                        <TextBlock Text="THERMAL" Style="{StaticResource ReadoutLabel}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding ActiveThermal}" Foreground="{StaticResource GraphiteInk}" FontWeight="Medium" />
                        <TextBlock Grid.Row="1" Text="CHARGING" Style="{StaticResource ReadoutLabel}" Margin="0,8,0,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ActiveCharge}" Foreground="{StaticResource GraphiteInk}" FontWeight="Medium" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="2" Text="WINDOWS" Style="{StaticResource ReadoutLabel}" Margin="0,8,0,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Live.WindowsMode}" Foreground="{StaticResource GraphiteInk}" FontWeight="Medium" Margin="0,8,0,0" />
                    </Grid>
                </Grid>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Visibility="{Binding IsChecked, ElementName=SettingsTab, Converter={StaticResource BoolToVisibility}}" BorderBrush="{StaticResource Rule}" BorderThickness="0,1,0,0" Padding="24,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Re-read" Style="{StaticResource QuietButton}" Click="Refresh_Click" IsEnabled="{Binding CanRefresh}"
                            ToolTip="F5" ToolTipService.InitialShowDelay="800" Margin="0,0,8,0" />
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsChecked, ElementName=SettingsTab, Converter={StaticResource BoolToVisibility}}">
                        <Button Content="Discard" Style="{StaticResource QuietButton}" Click="Revert_Click" IsEnabled="{Binding CanApply}" IsCancel="True"
                                ToolTip="Esc" ToolTipService.InitialShowDelay="800" Margin="0,0,8,0" />
                        <Button Content="{Binding ApplyLabel}" Style="{StaticResource PrimaryButton}" Click="Apply_Click" IsEnabled="{Binding CanApply}"
                                IsDefault="{Binding IsChecked, ElementName=SettingsTab}" MinWidth="124" ToolTip="Enter" ToolTipService.InitialShowDelay="800" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="0,0,24,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Description}">
                            <Style.Triggers><DataTrigger Binding="{Binding StatusIsError}" Value="True"><Setter Property="Foreground" Value="{StaticResource Error}" /></DataTrigger></Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1" Padding="24,0">
            <StackPanel Orientation="Horizontal" KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle">
                <RadioButton x:Name="SettingsTab" Content="Settings" Style="{StaticResource ViewTab}" GroupName="View" IsChecked="True"
                             ToolTip="Ctrl+1" ToolTipService.InitialShowDelay="800" />
                <RadioButton x:Name="AutomaticTab" Content="Automatic" Style="{StaticResource ViewTab}" GroupName="View"
                             ToolTip="Ctrl+2" ToolTipService.InitialShowDelay="800" />
                <RadioButton x:Name="ActivityTab" Content="Activity" Style="{StaticResource ViewTab}" GroupName="View"
                             ToolTip="Ctrl+3" ToolTipService.InitialShowDelay="800" />
            </StackPanel>
        </Border>
        <Grid>
            <!-- Scrolling is a fallback for reduced work areas, enlarged text or unusually long errors. -->
            <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsChecked, ElementName=SettingsTab, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Margin="24,20,24,20" IsEnabled="{Binding CanRefresh}">
                        <TextBlock Text="Thermal mode" Style="{StaticResource Heading}" />
                        <ItemsControl ItemsSource="{Binding ThermalOptions}" Style="{StaticResource SegmentGroup}" />
                        <TextBlock Text="{Binding SelectedThermalDescription}" Style="{StaticResource Description}" Margin="0,8,0,0" MinHeight="20" />
                        <TextBlock Text="{Binding PendingThermal}" Style="{StaticResource Description}" Foreground="{StaticResource Accent}"
                                   Visibility="{Binding HasPendingThermal, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="Battery charging" Style="{StaticResource Heading}" Margin="0,20,0,0" />
                        <ItemsControl ItemsSource="{Binding ChargeOptions}" Style="{StaticResource SegmentGroup}" IsEnabled="{Binding CanEditCharging}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <RadioButton Style="{StaticResource Segment}" Content="{Binding Label}" IsChecked="{Binding IsSelected}" Margin="0,0,8,8"
                                             AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding Description}"
                                             AutomationProperties.ItemStatus="{Binding AutomationStatus}" />
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding SelectedChargeDescription}" Style="{StaticResource Description}" MinHeight="20" />
                        <TextBlock Text="{Binding PendingCharge}" Style="{StaticResource Description}" Foreground="{StaticResource Accent}"
                                   Visibility="{Binding HasPendingCharge, Converter={StaticResource BoolToVisibility}}" />
                        <Grid Margin="0,8,0,0" Visibility="{Binding IsCustomCharge, Converter={StaticResource BoolToVisibility}}" IsEnabled="{Binding CanEditCharging}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="88" /><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                            <TextBlock Text="Start below" VerticalAlignment="Center" FontSize="{StaticResource TextSmall}" />
                            <Slider Grid.Column="1" Style="{StaticResource LimitSlider}" Margin="-12,0,4,0" Minimum="{Binding StartMin}" Maximum="{Binding StartMax}"
                                    Value="{Binding ChargeStart}" AutomationProperties.Name="Start charging below" />
                            <TextBlock Grid.Column="2" Text="{Binding ChargeStart, StringFormat={}{0}%}" VerticalAlignment="Center" HorizontalAlignment="Right"
                                       FontFamily="{StaticResource FontMono}" FontSize="{StaticResource TextSmall}" Foreground="{StaticResource Ink}" />
                            <TextBlock Grid.Row="1" Text="Stop at" VerticalAlignment="Center" FontSize="{StaticResource TextSmall}" />
                            <Slider Grid.Row="1" Grid.Column="1" Style="{StaticResource LimitSlider}" Margin="-12,0,4,0" Minimum="{Binding StopMin}" Maximum="{Binding StopMax}"
                                    Value="{Binding ChargeStop}" AutomationProperties.Name="Stop charging at" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding ChargeStop, StringFormat={}{0}%}" VerticalAlignment="Center" HorizontalAlignment="Right"
                                       FontFamily="{StaticResource FontMono}" FontSize="{StaticResource TextSmall}" Foreground="{StaticResource Ink}" />
                        </Grid>
                        <WrapPanel Margin="0,16,0,0">
                            <Button Content="ExpressCharge for 24 hours" Style="{StaticResource QuietButton}" Click="ChargeBoost_Click"
                                    IsEnabled="{Binding CanStartBoost}" Margin="0,0,8,8"
                                    ToolTip="Apply or discard pending edits before starting the timer. Requires ExpressCharge and Primarily AC Use support."
                                    ToolTipService.ShowOnDisabled="True" />
                            <Button Content="Return now" Style="{StaticResource QuietButton}" Click="ReturnCharge_Click"
                                    IsEnabled="{Binding CanReturnFromBoost}" Margin="0,0,0,8"
                                    ToolTip="Restore Primarily AC Use now. Apply or discard pending edits first." ToolTipService.ShowOnDisabled="True"
                                    Visibility="{Binding BoostActive, Converter={StaticResource BoolToVisibility}}" />
                        </WrapPanel>
                        <TextBlock Text="{Binding BoostStatus}" Style="{StaticResource Description}" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="AutomaticScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsChecked, ElementName=AutomaticTab, Converter={StaticResource BoolToVisibility}}">
                <local:AutomaticPanel Margin="24,20,24,20" DataContext="{Binding Automatic}" />
            </ScrollViewer>
            <ScrollViewer x:Name="ActivityScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsChecked, ElementName=ActivityTab, Converter={StaticResource BoolToVisibility}}">
                <local:ActivityPanel x:Name="Activity" Margin="24,20,24,24" />
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
