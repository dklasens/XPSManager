<Window x:Class="XpsManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:XpsManager.App"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:MainViewModel}"
        Title="XPS Manager"
        Icon="Assets/XpsManager.ico"
        Width="600"
        Height="850" MinWidth="600" MinHeight="560"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Paper}"
        Foreground="{StaticResource Ink2}"
        FontFamily="{StaticResource FontBody}"
        FontSize="{StaticResource TextBody}"
        UseLayoutRounding="True">

    <Window.Resources>
        <DataTemplate x:Key="SegmentTemplate" DataType="{x:Type local:OptionViewModel}">
            <RadioButton Style="{StaticResource Segment}" Content="{Binding ShortLabel}"
                         IsChecked="{Binding IsSelected}"
                         AutomationProperties.Name="{Binding Label}"
                         AutomationProperties.HelpText="{Binding Description}"
                         AutomationProperties.ItemStatus="{Binding AutomationStatus}" />
        </DataTemplate>
        <ItemsPanelTemplate x:Key="SegmentRow">
            <UniformGrid Rows="1" />
        </ItemsPanelTemplate>
        <Style x:Key="SegmentGroup" TargetType="ItemsControl">
            <Setter Property="ItemTemplate" Value="{StaticResource SegmentTemplate}" />
            <Setter Property="ItemsPanel" Value="{StaticResource SegmentRow}" />
            <Setter Property="Focusable" Value="False" />
            <!-- Tab enters the group once; arrow keys move within it. -->
            <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
            <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Cycle" />
            <Setter Property="Margin" Value="0,16,-8,0" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Readout: the one dark band. Leads with the battery figure; the table on the right
             shows what the BIOS holds now, with any pending change in cobalt beneath it. -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Graphite}" Padding="28,16,28,24">
            <StackPanel>
                <DockPanel>
                    <Image Source="{StaticResource XpsMark}" Width="16" Height="16" VerticalAlignment="Center"
                           AutomationProperties.Name="XPS Manager" />
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource ReadoutLabel}" VerticalAlignment="Center"
                               Text="{Binding Device.BiosVersion, StringFormat='BIOS {0}'}" />
                    <TextBlock Text="{Binding Device.Model}" Margin="12,0,0,0" VerticalAlignment="Center"
                               FontSize="{StaticResource TextSmall}" FontWeight="Medium"
                               Foreground="{StaticResource GraphiteInk}" />
                </DockPanel>

                <Grid Margin="0,24,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding Live.BatteryPercent}" FontFamily="{StaticResource FontDisplay}"
                                   FontWeight="Bold" FontSize="{StaticResource TextStat}"
                                   Foreground="{StaticResource GraphiteInk}"
                                   LineStackingStrategy="BlockLineHeight" LineHeight="62" />
                        <TextBlock Text="{Binding Live.SourceLine}" Style="{StaticResource ReadoutLabel}" Margin="4,4,0,4"
                                   ToolTip="{Binding Live.TimeLeftDetail}" ToolTipService.InitialShowDelay="600" />
                    </StackPanel>

                    <!-- In effect now: BIOS settings (pending change in cobalt beneath), then Windows and display. -->
                    <Grid Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" MinWidth="160" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <TextBlock Text="THERMAL" Style="{StaticResource ReadoutLabel}" Margin="0,4,16,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding ActiveThermal}" FontWeight="Medium" Foreground="{StaticResource GraphiteInk}" />
                            <TextBlock Text="{Binding PendingThermal}" Style="{StaticResource ReadoutLabel}"
                                       Foreground="{StaticResource GraphiteAccent}" Margin="0,4,0,0"
                                       Visibility="{Binding HasPendingThermal, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>

                        <TextBlock Grid.Row="1" Text="CHARGE" Style="{StaticResource ReadoutLabel}" Margin="0,12,16,0" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,8,0,0">
                            <TextBlock Text="{Binding ActiveCharge}" FontWeight="Medium" Foreground="{StaticResource GraphiteInk}"
                                       Typography.NumeralAlignment="Tabular" />
                            <TextBlock Text="{Binding PendingCharge}" Style="{StaticResource ReadoutLabel}"
                                       Foreground="{StaticResource GraphiteAccent}" Margin="0,4,0,0"
                                       Visibility="{Binding HasPendingCharge, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>

                        <TextBlock Grid.Row="2" Text="WINDOWS" Style="{StaticResource ReadoutLabel}" Margin="0,12,16,0" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Live.WindowsMode}" Margin="0,8,0,0"
                                   FontWeight="Medium" Foreground="{StaticResource GraphiteInk}"
                                   ToolTip="Windows power mode (Settings, System, Power)" ToolTipService.InitialShowDelay="600" />

                        <TextBlock Grid.Row="3" Text="DISPLAY" Style="{StaticResource ReadoutLabel}" Margin="0,12,16,0" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Live.Display}" Margin="0,8,0,0"
                                   FontWeight="Medium" Foreground="{StaticResource GraphiteInk}" Typography.NumeralAlignment="Tabular"
                                   ToolTip="{Binding Live.DisplayDetail}" ToolTipService.InitialShowDelay="600" />
                    </Grid>
                </Grid>

                <!-- Live strip: four figures, updated every second. Labels turn amber when hardware is limiting. -->
                <Border BorderBrush="{StaticResource GraphiteRule}" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,14,0,0">
                    <UniformGrid Rows="1">
                        <StackPanel ToolTip="Battery power right now. Excludes power the charger supplies directly."
                                    ToolTipService.InitialShowDelay="600">
                            <TextBlock Text="{Binding Live.BatteryLabel}" Style="{StaticResource ReadoutLabel}" />
                            <TextBlock Text="{Binding Live.BatteryValue}" Style="{StaticResource StripValue}" />
                        </StackPanel>
                        <StackPanel ToolTip="CPU package power: cores, graphics and the rest of the chip."
                                    ToolTipService.InitialShowDelay="600">
                            <TextBlock Text="PACKAGE" Style="{StaticResource ReadoutLabel}" />
                            <TextBlock Text="{Binding Live.Package}" Style="{StaticResource StripValue}" />
                        </StackPanel>
                        <StackPanel ToolTip="{Binding Live.CpuLimit}" ToolTipService.InitialShowDelay="600">
                            <TextBlock Text="{Binding Live.CpuStripLabel}" Style="{StaticResource StripLabel}"
                                       Tag="{Binding Live.CpuLimited}" />
                            <TextBlock Text="{Binding Live.PCoreClock}" Style="{StaticResource StripValue}" />
                        </StackPanel>
                        <StackPanel ToolTip="{Binding Live.GpuLimit}" ToolTipService.InitialShowDelay="600">
                            <TextBlock Text="{Binding Live.GpuStripLabel}" Style="{StaticResource StripLabel}"
                                       Tag="{Binding Live.GpuLimited}" />
                            <TextBlock Text="{Binding Live.GpuClock}" Style="{StaticResource StripValue}" />
                        </StackPanel>
                    </UniformGrid>
                </Border>
            </StackPanel>
        </Border>

        <!-- Action bar -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Rule}" BorderThickness="0,1,0,0" Padding="28,12,28,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Re-read" Style="{StaticResource QuietButton}" Click="Refresh_Click"
                            IsEnabled="{Binding CanRefresh}" ToolTip="F5" ToolTipService.InitialShowDelay="800" Margin="0,0,8,0" />
                    <Button Content="Discard" Style="{StaticResource QuietButton}" Click="Revert_Click"
                            IsEnabled="{Binding CanApply}" IsCancel="True" ToolTip="Esc" ToolTipService.InitialShowDelay="800" Margin="0,0,8,0" />
                    <Button Content="{Binding ApplyLabel}" Style="{StaticResource PrimaryButton}" Click="Apply_Click"
                            IsEnabled="{Binding CanApply}" IsDefault="True" MinWidth="124" ToolTip="Enter" ToolTipService.InitialShowDelay="800" />
                </StackPanel>
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="0,0,16,0" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Description}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Error}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- Views: Settings is the default; Activity is the detailed live readout. -->
        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1" Padding="28,4,28,0">
            <StackPanel Orientation="Horizontal" KeyboardNavigation.TabNavigation="Once"
                        KeyboardNavigation.DirectionalNavigation="Cycle">
                <RadioButton x:Name="SettingsTab" Content="Settings" Style="{StaticResource ViewTab}" GroupName="View"
                             IsChecked="True" ToolTip="Ctrl+1" ToolTipService.InitialShowDelay="800" />
                <RadioButton x:Name="ActivityTab" Content="Activity" Style="{StaticResource ViewTab}" GroupName="View"
                             ToolTip="Ctrl+2" ToolTipService.InitialShowDelay="800" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
        <local:ActivityPanel x:Name="Activity" Margin="28,20,28,20"
                             Visibility="{Binding IsChecked, ElementName=ActivityTab, Converter={StaticResource BoolToVisibility}}" />
        <StackPanel Margin="28,24,28,32" IsEnabled="{Binding CanRefresh}">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsChecked, ElementName=SettingsTab}" Value="True" />
                                <Condition Binding="{Binding IsLoaded}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="Thermal mode" Style="{StaticResource Heading}" />
            <ItemsControl ItemsSource="{Binding ThermalOptions}" Style="{StaticResource SegmentGroup}" />
            <TextBlock Text="{Binding SelectedThermalDescription}" Style="{StaticResource Description}" Margin="0,12,0,0" />

            <Border Height="1" Background="{StaticResource Rule}" Margin="0,28,0,20" />

            <TextBlock Text="Battery charging" Style="{StaticResource Heading}" />
            <ItemsControl ItemsSource="{Binding ChargeOptions}" Style="{StaticResource SegmentGroup}" />
            <TextBlock Text="{Binding SelectedChargeDescription}" Style="{StaticResource Description}" Margin="0,12,0,0" />

            <Grid Margin="0,16,0,0" Visibility="{Binding IsCustomCharge, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <TextBlock Text="Start below" VerticalAlignment="Center" FontSize="{StaticResource TextSmall}" />
                <Slider Grid.Column="1" Style="{StaticResource LimitSlider}" Margin="-12,0,4,0"
                        Minimum="{Binding StartMin}" Maximum="{Binding StartMax}" Value="{Binding ChargeStart}"
                        AutomationProperties.Name="Start charging below" />
                <TextBlock Grid.Column="2" Text="{Binding ChargeStart, StringFormat={}{0}%}" VerticalAlignment="Center"
                           HorizontalAlignment="Right" FontFamily="{StaticResource FontMono}"
                           FontSize="{StaticResource TextSmall}" Foreground="{StaticResource Ink}" />

                <TextBlock Grid.Row="1" Text="Stop at" VerticalAlignment="Center" FontSize="{StaticResource TextSmall}" />
                <Slider Grid.Row="1" Grid.Column="1" Style="{StaticResource LimitSlider}" Margin="-12,0,4,0"
                        Minimum="{Binding StopMin}" Maximum="{Binding StopMax}" Value="{Binding ChargeStop}"
                        AutomationProperties.Name="Stop charging at" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding ChargeStop, StringFormat={}{0}%}" VerticalAlignment="Center"
                           HorizontalAlignment="Right" FontFamily="{StaticResource FontMono}"
                           FontSize="{StaticResource TextSmall}" Foreground="{StaticResource Ink}" />
            </Grid>
        </StackPanel>
        </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
