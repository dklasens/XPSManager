<!-- Hallmark · component: automatic settings · theme: Cobalt · motion: none
     pre-emit critique: P4 H4 E4 S5 R5 V4 · existing native WPF design system retained
     States: native checkbox/selector focus, hover, pressed; busy disables; inline error/success. -->
<UserControl x:Class="XpsManager.App.AutomaticPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource FontBody}" FontSize="{StaticResource TextBody}" Foreground="{StaticResource Ink2}">
    <StackPanel>
        <TextBlock Text="Automatic" Style="{StaticResource Heading}" />
        <StackPanel IsEnabled="{Binding CanEdit}">
            <CheckBox Content="Follow Windows power mode" Style="{StaticResource AutoToggle}" Margin="0,4,0,0"
                      VerticalContentAlignment="Center" FontWeight="Medium" FocusVisualStyle="{StaticResource FocusRing}"
                      IsChecked="{Binding Enabled, Mode=OneWay}" Click="Toggle_Click" />
            <TextBlock Style="{StaticResource Description}" Margin="0,4,0,8"
                       Text="Runs with the app closed. Manual thermal choices last until the next power-mode change." />
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,4,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="176" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{Binding Label}" FontSize="{StaticResource TextSmall}" FontWeight="Medium" />
                                <TextBlock Text="{Binding Hint}" Style="{StaticResource Description}" FontSize="{StaticResource TextLabel}" Margin="0,4,0,0" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Style="{StaticResource MappingSelector}" Padding="8,4" VerticalContentAlignment="Center"
                                      FontFamily="{StaticResource FontBody}" FontSize="{StaticResource TextSmall}"
                                      FocusVisualStyle="{StaticResource FocusRing}"
                                      ItemsSource="{Binding DataContext.Options, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Selected}"
                                      AutomationProperties.Name="{Binding Label}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Style="{StaticResource Description}" Foreground="{StaticResource Warn}" Margin="0,4,0,12"
                       Visibility="{Binding OptimizerInstalled, Converter={StaticResource BoolToVisibility}}"
                       Text="Dell Optimizer is installed. Keep its power-mode sync off to avoid conflicting changes." />
            <WrapPanel Margin="0,4,0,0">
                <Button Content="Save mappings" Style="{StaticResource QuietButton}" Click="Save_Click" Margin="0,0,8,8" />
                <Button Content="Remove background service" Style="{StaticResource QuietButton}" Click="Remove_Click" Margin="0,0,0,8"
                        Visibility="{Binding CanRemoveService, Converter={StaticResource BoolToVisibility}}" />
            </WrapPanel>
            <Button Content="Update installed service" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Click="Update_Click"
                    Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,8" />
            <TextBlock Style="{StaticResource Description}" Margin="0,0,0,8"
                       Visibility="{Binding ManagedByInstaller, Converter={StaticResource BoolToVisibility}}"
                       Text="Update using the newer installer. Uninstall through Windows Settings > Apps > Installed apps." />
        </StackPanel>
        <TextBlock Text="{Binding Status}" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Description}">
                    <Style.Triggers><DataTrigger Binding="{Binding StatusIsError}" Value="True"><Setter Property="Foreground" Value="{StaticResource Error}" /></DataTrigger></Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </StackPanel>
</UserControl>
